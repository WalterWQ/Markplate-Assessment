<ContentPage
    x:Class="StarterApp.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Item Details">

    <ScrollView>
		<VerticalStackLayout Padding="20" Spacing="12">

			<Label Text="{Binding Item.Title}"
				   FontSize="26"
				   FontAttributes="Bold" />

			<Label Text="{Binding Item.Description}"
				   FontSize="16" />

			<Label Text="{Binding Item.DailyRate, StringFormat='Daily rate: £{0:F2}'}"
				   FontSize="18"
				   FontAttributes="Bold" />

			<Label Text="{Binding Item.Category, StringFormat='Category: {0}'}" />

			<Label Text="{Binding Item.Latitude, StringFormat='Latitude: {0:F5}'}" />

			<Label Text="{Binding Item.Longitude, StringFormat='Longitude: {0:F5}'}" />

            <Button Text="Request Rental" Command="{Binding NavigateToRentalsCommand}" />
            
            <Button Text="Manage Item" Command="{Binding NavigateToOwnerCommand}" />

            <Label Text="{Binding ErrorMessage}"
				   TextColor="Red"
				   IsVisible="{Binding HasError}" />

		</VerticalStackLayout>
    </ScrollView>
</ContentPage>
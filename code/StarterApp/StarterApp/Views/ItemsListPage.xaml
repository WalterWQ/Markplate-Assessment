<ContentPage
    x:Class="StarterApp.Views.ItemsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Items">

    <Grid Padding="20"
          RowSpacing="12"
          RowDefinitions="Auto,Auto,Auto,Auto,*">

        <Label Grid.Row="0"
               Text="Available Items"
               FontSize="24"
               FontAttributes="Bold" />

        <Button Grid.Row="1"
                Text="Refresh"
                Command="{Binding LoadItemsCommand}" />

        <Button Grid.Row="2"
            Text="Find Near Me"
            Command="{Binding NavigateToNearbyItemsCommand}" />

        <Button Grid.Row="3"
                Text="Create Item"
                Command="{Binding NavigateToCreateItemCommand}" />

        <Label Grid.Row="4"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               IsVisible="{Binding HasError}" />

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenItemCommand}"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding Description}" />

                            <Label Text="{Binding DailyRate, StringFormat='£{0:F2} per day'}" />

                            <Label Text="{Binding Category}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
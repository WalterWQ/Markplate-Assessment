<ContentPage
    x:Class="StarterApp.Views.ItemsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Items">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Available Items"
               FontSize="24"
               FontAttributes="Bold" />

        <Button Text="Refresh"
                Command="{Binding LoadItemsCommand}" />

        <Button Text="Create Item"
                Command="{Binding NavigateToCreateItemCommand}" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="Red"
               IsVisible="{Binding HasError}" />

        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,6">
						<Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenItemCommand}"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding Description}" />

                            <Label Text="{Binding DailyRate, StringFormat='£{0:F2} per day'}" />

                            <Label Text="{Binding Category}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>